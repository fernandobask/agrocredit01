rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSimulation(data) {
      return data.keys().hasAll(['userId', 'name', 'contractData', 'scenariosData', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.name is string && data.name.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /simulations/{simulationId} {
      allow read: if isOwner(resource.data.userId);
      
      allow create: if isOwner(incoming().userId)
        && isValidSimulation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && isValidSimulation(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'contractData', 'scenariosData', 'updatedAt']);

      allow delete: if isOwner(existing().userId);
    }
  }
}
