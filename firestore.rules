rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSimulation(data) {
      return data.keys().hasAll(['userId', 'name', 'contractData', 'scenariosData', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.name is string && data.name.size() <= 250
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /simulations/{simulationId} {
      allow read: if isOwner(resource.data.userId);
      
      allow create: if isOwner(incoming().userId)
        && isValidSimulation(incoming());

      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && incoming().userId == existing().userId
        && isValidSimulation(incoming());

      allow delete: if isOwner(existing().userId);
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['id', 'userId', 'contratoNumero', 'emitente', 'proposalData', 'createdAt'])
        && data.id is string
        && data.userId is string
        && data.contratoNumero is string
        && data.emitente is string
        && data.createdAt is string;
    }

    match /propostas_negociacao/{proposalId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isOwner(incoming().userId)
        && isValidProposal(incoming());

      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && incoming().userId == existing().userId
        && isValidProposal(incoming());

      allow delete: if isOwner(existing().userId);
    }
  }
}
