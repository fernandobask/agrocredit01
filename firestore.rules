rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    match /simulations/{simulationId} {
      // Regra de segurança: Apenas usuários autenticados podem ler e escrever
      allow read, write: if isSignedIn();
    }
    match /propostas_negociacao/{proposalId} {
      allow read, write: if isSignedIn();
    }
    match /fila_processamento/{taskId} {
      allow read, write: if isSignedIn();
    }
  }
}
