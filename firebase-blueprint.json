{
  "entities": {
    "Simulation": {
      "title": "Simulation",
      "description": "A saved rural credit simulation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "contrato": { "type": "object" },
        "cenarios": { "type": "array" },
        "laudo": { "type": "object", "description": "Relatório de irregularidades e auditoria da IA" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "contrato", "cenarios", "createdAt", "updatedAt"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "A saved negotiation proposal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "contratoNumero": { "type": "string" },
        "emitente": { "type": "string" },
        "proposalData": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "contratoNumero", "emitente", "proposalData", "createdAt"]
    },
    "QueueTask": {
      "title": "QueueTask",
      "description": "A scheduled document processing task in the queue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "simulationId": { "type": "string" },
        "contractNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "processando", "concluido", "erro"] },
        "driveFileId": { "type": "string" },
        "driveFileName": { "type": "string" },
        "driveMimeType": { "type": "string" },
        "auxiliaryFiles": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "errorMessage": { "type": "string" }
      },
      "required": ["simulationId", "contractNumber", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "simulations/{simulationId}": {
      "schema": { "$ref": "#/entities/Simulation" },
      "description": "User saved simulations"
    },
    "propostas_negociacao/{proposalId}": {
      "schema": { "$ref": "#/entities/Proposal" },
      "description": "User saved negotiation proposals"
    },
    "fila_processamento/{taskId}": {
      "schema": { "$ref": "#/entities/QueueTask" },
      "description": "Firestore task queue for document analysis"
    }
  }
}
